{
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "run_shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "goal hook pre-tool-use",
            "name": "goal-at-home-pre-tool"
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "goal hook stop",
            "name": "goal-at-home-stop"
          }
        ]
      }
    ]
  }
}
